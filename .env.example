# Leadomi SIP production configuration. Do not commit populated secrets.
# Coolify: configure these as runtime variables. Direct Compose: chmod 600 .env.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SIP_DOMAIN=
GOSIP_PUBLIC_URL=https://sip.example.com
GOSIP_CORS_ORIGINS=https://sip.example.com
GOSIP_PBX_URL=http://pbx:8088
GOSIP_PBX_SECRET=
GOSIP_PBX_SIP_DOMAIN=sip.example.com
GOSIP_PBX_TRUNK_USER=leadomi_incoming
GOSIP_PBX_TRUNK_PASSWORD=
PBX_DOMAIN=sip.example.com
PBX_PUBLIC_IP=
PBX_TWILIO_USER=leadomi_bootstrap
PBX_TWILIO_PASSWORD=
# Optional for preserving pre-existing dedicated credentials only.
PBX_TWILIO_DEVICE_PASSWORDS=
GOSIP_OUTBOUND_CALLER_ID=
# Existing external volume, only required by docker-compose.coolify.yml.
GOSIP_VOLUME_NAME=
TZ=Asia/Kolkata
# Keep GOSIP_PBX_UNUSED_API_CREDENTIAL undefined/empty.
# Local Go backend development defaults (production compose fixes these).
GOSIP_DATA_DIR=./data
GOSIP_DB_PATH=./data/gosip.db
GOSIP_HTTP_PORT=8080
GOSIP_SIP_PORT=5060
GOSIP_LOG_LEVEL=info
GOSIP_DEV_MODE=false
